# Copy this file to ".env" and fill in real values there.
# ".env" is in .gitignore, so it will never be committed to git.

# --- Elasticsearch (keyword / structured search) ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=car_listings

# --- Qdrant (vector / semantic search) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=car_listings

# --- Embeddings provider (used later to turn descriptions into vectors) ---
# Example if using OpenAI-style embeddings API — replace with whatever you pick.
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

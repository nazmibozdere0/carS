# Copy this file to ".env" and fill in real values there.
# ".env" is in .gitignore, so it will never be committed to git.

# --- Elasticsearch (keyword / structured search) ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=car_listings

# --- Qdrant (vector / semantic search) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=car_listings

# --- Embeddings (turns description text into vectors for Qdrant) ---
# Using a free local model (sentence-transformers) — no API key needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2
